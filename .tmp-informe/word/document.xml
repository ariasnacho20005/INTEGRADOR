 w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">Clientes</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="6500" w:type="dxa"/><w:shd w:fill="F1F5F8"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">Registrar clientes con identificación, nombre y contacto.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="2400" w:type="dxa"/><w:shd w:fill="FFFFFF"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">Pedidos</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="6500" w:type="dxa"/><w:shd w:fill="FFFFFF"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">Confirmar una venta, calcular el importe y descontar unidades del stock.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="2400" w:type="dxa"/><w:shd w:fill="F1F5F8"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">Estadísticas</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="6500" w:type="dxa"/><w:shd w:fill="F1F5F8"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">Consultar cantidades de productos, unidades, clientes, pedidos y ventas acumuladas.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="2400" w:type="dxa"/><w:shd w:fill="FFFFFF"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">Rendimiento</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="6500" w:type="dxa"/><w:shd w:fill="FFFFFF"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">Comparar búsquedas y ordenamientos con datos de prueba de distintos tamaños.</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">Diseño orientado a objetos</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:t xml:space="preserve">Producto es una clase abstracta que reúne el código, el nombre, el precio base en centavos, el stock y los pedidos asociados. ProductoAlimenticio y ProductoElectronico heredan de ella y calculan el precio final con reglas distintas. La operación de venta trabaja con la abstracción Producto y obtiene el importe mediante despacho polimórfico.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:t xml:space="preserve">Distribuidora administra las listas de productos, clientes y pedidos. Cliente y Producto mantienen referencias a sus pedidos; cada Pedido refiere a un cliente, un producto, una cantidad, una fecha y un importe total. Las clases encapsulan sus datos y exponen copias de las listas para evitar modificaciones externas directas.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:t xml:space="preserve">Main implementa la interacción por consola. Algoritmos reúne las búsquedas y ordenamientos manuales. BenchmarkService prepara las mediciones y devuelve objetos ResultadoBenchmark con los tiempos obtenidos.</w:t></w:r></w:p><w:p><w:r><w:br w:type="page"/></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">Diagrama de clases UML</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Small"/></w:pPr><w:r><w:t xml:space="preserve">El diagrama representa las clases principales, sus responsabilidades y relaciones de herencia, asociación y dependencia.</w:t></w:r></w:p><w:p><w:pPr><w:jc w:val="center"/><w:spacing w:before="120" w:after="80"/></w:pPr><w:r><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0"><wp:extent cx="6200000" cy="4820000"/><wp:docPr id="1" name="Diagrama UML de clases" descr="Clases principales del sistema Java de consola y sus relaciones"/><wp:cNvGraphicFramePr><a:graphicFrameLocks noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic><pic:nvPicPr><pic:cNvPr id="0" name="diagrama-uml-distribuidora.png"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId3"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="6200000" cy="4820000"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Caption"/></w:pPr><w:r><w:t xml:space="preserve">Figura 1. Estructura de clases de la aplicación Java de consola.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">Reglas de negocio y validaciones</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:t xml:space="preserve">Los precios se almacenan como centavos enteros. El precio final de un producto alimenticio aplica un descuento del 5 % al precio base. El precio final de un electrónico suma un recargo proporcional del 1 % por cada seis meses de garantía; el período admitido va de 0 a 360 meses. Los cálculos monetarios usan BigDecimal y redondeo HALF_UP para controlar la precisión.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:t xml:space="preserve">Antes de confirmar un pedido, Distribuidora valida que la cantidad sea positiva, que existan el cliente y el producto, que haya stock suficiente y que el alimento no esté vencido. El importe se calcula antes de descontar stock. Si una validación falla, se informa el error y no se confirma la venta.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:t xml:space="preserve">La entrada de consola vuelve a solicitar valores vacíos o inválidos. Las excepciones de las operaciones se capturan en el menú para que un error controlado no cierre el programa de forma inesperada.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">Algoritmos y complejidad</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:t xml:space="preserve">La búsqueda lineal compara códigos desde el inicio de la lista y funciona sobre el orden actual de registro. Puede requerir O(n) comparaciones. La búsqueda binaria opera sobre una copia ordenada por código; realiza O(log n) comparaciones, pero requiere preparar ese índice con merge sort, cuyo costo es O(n log n). La búsqueda operativa del menú utiliza la versión lineal; la binaria se compara en el benchmark.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:t xml:space="preserve">Selection sort conserva una implementación didáctica de costo O(n²) y se utiliza como referencia en la comparación de rendimiento. Merge sort cuesta O(n log n) y es el método que el menú utiliza para ordenar el catálogo. En ambos ordenamientos, el precio final se presenta de mayor a menor y los empates se resuelven por código ascendente.</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblW w:w="0" w:type="auto"/><w:tblLayout w:type="fixed"/><w:tblBorders><w:top w:val="single" w:sz="5" w:color="D9D9D9"/><w:left w:val="single" w:sz="5" w:color="D9D9D9"/><w:bottom w:val="single" w:sz="5" w:color="D9D9D9"/><w:right w:val="single" w:sz="5" w:color="D9D9D9"/><w:insideH w:val="single" w:sz="5" w:color="D9D9D9"/><w:insideV w:val="single" w:sz="5" w:color="D9D9D9"/></w:tblBorders></w:tblPr><w:tblGrid><w:gridCol w:w="2500"/><w:gridCol w:w="2200"/><w:gridCol w:w="4200"/></w:tblGrid><w:tr><w:trPr><w:tblHeader/></w:trPr><w:tc><w:tcPr><w:tcW w:w="2500" w:type="dxa"/><w:shd w:fill="17324D"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF"/><w:b/></w:rPr><w:t xml:space="preserve">Algoritmo</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="2200" w:type="dxa"/><w:shd w:fill="17324D"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF"/><w:b/></w:rPr><w:t xml:space="preserve">Costo temporal</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="4200" w:type="dxa"/><w:shd w:fill="17324D"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF"/><w:b/></w:rPr><w:t xml:space="preserve">Uso en el sistema</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="2500" w:type="dxa"/><w:shd w:fill="FFFFFF"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">Búsqueda lineal</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="2200" w:type="dxa"/><w:shd w:fill="FFFFFF"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">O(n)</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="4200" w:type="dxa"/><w:shd w:fill="FFFFFF"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">Búsqueda de productos desde el menú.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="2500" w:type="dxa"/><w:shd w:fill="F1F5F8"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">Búsqueda binaria</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="2200" w:type="dxa"/><w:shd w:fill="F1F5F8"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">O(log n)</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="4200" w:type="dxa"/><w:shd w:fill="F1F5F8"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">Benchmark sobre índice ordenado por código.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="2500" w:type="dxa"/><w:shd w:fill="FFFFFF"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">Selection sort</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="2200" w:type="dxa"/><w:shd w:fill="FFFFFF"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">O(n²)</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="4200" w:type="dxa"/><w:shd w:fill="FFFFFF"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">Referencia de comparación en el benchmark.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="2500" w:type="dxa"/><w:shd w:fill="F1F5F8"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">Merge sort</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="2200" w:type="dxa"/><w:shd w:fill="F1F5F8"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">O(n log n)</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="4200" w:type="dxa"/><w:shd w:fill="F1F5F8"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="222222"/></w:rPr><w:t xml:space="preserve">Ordenamiento del catálogo y preparación del índice.</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">Metodología y resultados de rendimiento</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:t xml:space="preserve">BenchmarkService genera conjuntos de 100, 1.000 y 10.000 productos. Cada medición utiliza cinco repeticiones y las búsquedas ejecutan 1.000 consultas por repetición. Antes de cronometrar, se calientan las clases y las rutas del benchmark. La preparación del índice, la copia de listas y la generación de datos se informan por separado del tiempo de búsqueda u ordenamiento.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:t xml:space="preserve">Para cada tamaño se prueban el mismo código existente y el mismo código ausente con búsqueda lineal y binaria. El ordenamiento por selección y merge sort recibe copias del mismo conjunto; al finalizar, el programa comprueba que ambos algoritmos produjeron el mismo orden.</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblW w:w="0" w:type="auto"/><w:tblLayout w:type="fixed"/><w:tblBorders><w:top w:val="single" w:sz="5" w:color="D9D9D9"/><w:left w:val="single" w:sz="5" w:color="D9D9D9"/><w:bottom w:val="single" w:sz="5" w:color="D9D9D9"/><w:right w:val="single" w:sz="5" w:color="D9D9D9"/><w:insideH w:val="single" w:sz="5" w:color="D9D9D9"/><w:insideV w:val="single" w:sz="5" w:color="D9D9D9"/></w:tblBorders></w:tblPr><w:tblGrid><w:gridCol w:w="6000"/><w:gridCol w:w="2900"/></w:tblGrid><w:tr><w:trPr><w:tblHeader/></w:trPr><w:tc><w:tcPr><w:tcW w:w="6000" w:type="dxa"/><w:shd w:fill="17324D"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF"/><w:b/></w:rPr><w:t xml:space="preserve">Medición documentada con 10.000 productos</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="2900" w:type="dxa"/><w:shd w:fill="17324D"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tcMar></w:tcPr><w:p><w:pPr><w:pStyle w:val="TableText"/></w:pPr><w:r><w:rPr><w:color w:val="FFFFFF"/><w:b/></w:rPr><w:t xml:space="preserve">Resultado</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="6000" w:type="dxa"/><w:shd w:fill="FFFFFF"/><w:vAlign w:val="center"/><w:tcMar><w:top w:w="110" w:type="dxa"/><w:left w:w="120" w:type="dxa"/><w:bottom w:w="110" w:type="dxa"/><w:right w:w="120" w:type="dxa"/><
@startuml
title Sistema de gestión de distribuidora
left to right direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #F7FAFC
  BorderColor #587184
  ArrowColor #587184
  FontColor #17324D
}

package "com.distribuidora" {
  class Main {
    - ENTRADA: Scanner
    - DISTRIBUIDORA: Distribuidora
    + main(args): void
    - mostrarMenu(): void
    - registrarProducto(): void
    - crearPedido(): void
    - ejecutarBenchmark(): void
  }
}

package "com.distribuidora.modelo" {
  class Cliente {
    - identificacion: String
    - nombre: String
    - contacto: String
    - pedidos: ArrayList<Pedido>
    + agregarPedido(p): void
    + getPedidos(): ArrayList<Pedido>
  }
  abstract class Producto {
    - codigo: String
    - nombre: String
    - precioBaseCentavos: long
    - stock: int
    - pedidos: ArrayList<Pedido>
    + getPrecioFinalCentavos(): long
    + reducirStock(cantidad): void
    # calcularPrecioFinalCentavos(): long
  }
  class ProductoAlimenticio {
    - fechaVencimiento: LocalDate
    + estaVencido(fecha): boolean
    + getDetalle(): String
    # calcularPrecioFinalCentavos(): long
  }
  class ProductoElectronico {
    - mesesGarantia: int
    + getMesesGarantia(): int
    + getDetalle(): String
    # calcularPrecioFinalCentavos(): long
  }
  class Pedido {
    - codigo: long
    - cliente: Cliente
    - producto: Producto
    - cantidad: int
    - fecha: LocalDateTime
    - importeTotalCentavos: long
  }
}

package "com.distribuidora.servicio" {
  class Distribuidora {
    - productos: ArrayList<Producto>
    - clientes: ArrayList<Cliente>
    - pedidos: ArrayList<Pedido>
    + registrarProducto(p): void
    + registrarCliente(c): void
    + buscarProducto(codigo): Producto
    + confirmarPedido(id, codigo, cantidad): Pedido
    + ordenarProductosPorPrecio(): ArrayList<Producto>
  }
  class BenchmarkService {
    - TAMANOS: int[]
    - REPETICIONES: int = 5
    + ejecutarPruebas(): ArrayList<ResultadoBenchmark>
  }
  class ResultadoBenchmark {
    - cantidad: int
    - generarDatosNs: double
    - copiarIndiceNs: double
    - ordenarIndiceCodigoNs: double
    - linealExisteNs: double
    - binariaExisteNs: double
    - linealAusenteNs: double
    - binariaAusenteNs: double
    - seleccionNs: double
    - mergeSortNs: double
  }
}

package "com.distribuidora.algoritmos" {
  class Algoritmos <<utility>> {
    + busquedaLineal(lista, codigo): Producto {static}
    + busquedaBinaria(indice, codigo): Producto {static}
    + ordenarSeleccionPorPrecio(lista): void {static}
    + mergeSortPorPrecio(lista): ArrayList<Producto> {static}
    + prepararIndicePorCodigo(lista): ArrayList<Producto> {static}
  }
}

Producto <|-- ProductoAlimenticio
Producto <|-- ProductoElectronico
Distribuidora "1" o-- "0..*" Producto : inventario
Distribuidora "1" o-- "0..*" Cliente : clientes
Distribuidora "1" o-- "0..*" Pedido : pedidos
Cliente "1" -- "0..*" Pedido : realiza
Producto "1" -- "0..*" Pedido : aparece en
Main ..> Distribuidora : administra
Main ..> BenchmarkService : ejecuta
Main ..> ResultadoBenchmark : presenta
Distribuidora ..> Algoritmos : busca y ordena
BenchmarkService ..> Algoritmos : compara
BenchmarkService ..> ProductoAlimenticio : genera datos
BenchmarkService ..> ProductoElectronico : genera datos
BenchmarkService ..> ResultadoBenchmark : produce
Algoritmos ..> Producto : procesa
@enduml
